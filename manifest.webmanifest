{
  "name": "DIOS Amplifier",
  "short_name": "DIOS Amp",
  "description": "Mic booster for Discord up to 100,000x, with a soundboard and YouTube.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0d060b",
  "theme_color": "#0d060b",
  "categories": ["music", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Soundboard", "url": "/?source=app#board", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Amplifier", "url": "/?source=app#amp", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
